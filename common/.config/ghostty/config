# window options

theme = colourme 
font-family = "Hack Nerd Font"
font-codepoint-map = U+2591-U+2593=Hack Nerd Font
font-size = 12

background-opacity = 0.9
background-blur = macos-glass-regular

window-padding-x = 16
window-padding-y = 16
window-height = 24
window-width = 80
macos-titlebar-style = hidden
window-inherit-working-directory = true
drag-handle = never

# cmd+enter for nvim copilot autocomplete
keybind = cmd+enter=text:\x1b[13;9u

macos-icon = glass 
