# window options

theme = One Double Dark
font-family = "JetBrains Mono"
font-size = 12
background-opacity = 0.95
background-blur = 20 
window-padding-x = 16
window-padding-y = 16
window-height = 24
window-width = 80
macos-titlebar-style = hidden

# cmd+enter for nvim copilot autocomplete

keybind = cmd+enter=text:\xaa
