# window options

theme = Gruvbox Material Hard 
font-family = "JetBrainsMono Nerd Font"
font-size = 12 

background-opacity = 0.92
background-blur = macos-glass-regular

window-padding-x = 16
window-padding-y = 16
window-height = 24
window-width = 80
macos-titlebar-style = hidden
window-inherit-working-directory = true
drag-handle = never

# cmd+enter for nvim copilot autocomplete
keybind = cmd+enter=text:\x1b[13;9u

macos-icon = glass 
